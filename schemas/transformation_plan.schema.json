{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://journalport.org/schemas/v2/transformation_plan.schema.json","title":"JournalPort TransformationPlan","type":"object","additionalProperties":false,"required":["schema_version","plan_version","journalport_version","input_artifact_path","input_artifact_hash","canonical_manuscript_hash","profile_id","profile_version","resolved_profile_hash","compliance_report_hash","created_at","actions","automatic_action_count","approval_required_action_count","forbidden_action_count","plan_status","plan_hash"],"properties":{"schema_version":{"const":"2.0.0"},"plan_version":{"const":"1.0.0"},"journalport_version":{"type":"string"},"input_artifact_path":{"type":"string"},"input_artifact_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"canonical_manuscript_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"profile_id":{"type":"string"},"profile_version":{"type":"string"},"resolved_profile_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"compliance_report_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"created_at":{"type":"string","format":"date-time"},"actions":{"type":"array","items":{"$ref":"https://journalport.org/schemas/v1/transformation_action.schema.json"}},"automatic_action_count":{"type":"integer","minimum":0},"approval_required_action_count":{"type":"integer","minimum":0},"forbidden_action_count":{"type":"integer","minimum":0},"plan_status":{"enum":["READY_FOR_SAFE_EXECUTION","APPROVAL_REQUIRED","BLOCKED","NO_CHANGES_REQUIRED","INVALID_INPUT"]},"plan_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
