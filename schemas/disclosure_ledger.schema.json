{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://journalport.org/schemas/v1/disclosure_ledger.schema.json",
  "title": "JournalPort DisclosureLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "entries": {"type": "array", "items": {
    "type": "object", "additionalProperties": false,
    "required": ["timestamp", "session_id", "task_type", "model_host", "model_name_if_known", "privacy_mode", "disclosed_object_ids", "disclosed_content_hashes", "purpose", "approximate_size_or_token_count", "full_document_disclosed"],
    "properties": {
      "timestamp": {"type": "string", "format": "date-time"}, "session_id": {"type": "string"}, "task_type": {"type": "string"}, "model_host": {"type": "string"}, "model_name_if_known": {"type": ["string", "null"]}, "privacy_mode": {"enum": ["LOCAL_ONLY", "CODEX_HOSTED", "REMOTE_AGENT"]},
      "disclosed_object_ids": {"type": "array", "items": {"type": "string"}}, "disclosed_content_hashes": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}, "purpose": {"type": "string"}, "approximate_size_or_token_count": {"type": "integer", "minimum": 0}, "full_document_disclosed": {"type": "boolean"}
    }}}
  }
}
