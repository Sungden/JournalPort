{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://journalport.org/schemas/v1/manifest.schema.json",
  "title": "JournalPort Submission Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "created_at", "journalport_version", "target", "profile", "inputs", "outputs", "transformations", "approvals", "validators", "renderers", "citation_style", "verification"],
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size_bytes", "media_type"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "media_type": {"type": "string"}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "journalport_version": {"type": "string"},
    "target": {"type": "object", "additionalProperties": false, "required": ["journal", "article_type"], "properties": {"journal": {"type": "string"}, "article_type": {"type": "string"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_version", "sha256", "verification_status"], "properties": {"profile_id": {"type": "string"}, "profile_version": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "verification_status": {"enum": ["VERIFIED", "PARTIAL", "STALE", "CONFLICTED", "UNKNOWN"]}}},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "transformations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["action_id", "classification", "result"], "properties": {"action_id": {"type": "string"}, "classification": {"enum": ["SAFE_AUTOMATIC", "CONTENT_PRESERVING_AUTOMATIC", "AUTHOR_APPROVAL_REQUIRED"]}, "result": {"enum": ["APPLIED", "SKIPPED", "FAILED"]}}}},
    "approvals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["action_id", "approved_by", "approved_at", "scope_hash"], "properties": {"action_id": {"type": "string"}, "approved_by": {"type": "string"}, "approved_at": {"type": "string", "format": "date-time"}, "scope_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
    "validators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
    "renderers": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "citation_style": {"type": "object", "additionalProperties": false, "required": ["csl_version", "style_id", "style_hash"], "properties": {"csl_version": {"type": ["string", "null"]}, "style_id": {"type": ["string", "null"]}, "style_hash": {"oneOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "report_path", "report_hash", "independent"], "properties": {"status": {"enum": ["SUBMISSION_READY", "READY_WITH_WARNINGS", "BLOCKED", "VERIFICATION_FAILED"]}, "report_path": {"type": "string"}, "report_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "independent": {"const": true}}}
  }
}

