{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://journalport.org/schemas/v1/compliance_finding.schema.json","title":"JournalPort ComplianceFinding","type":"object","additionalProperties":false,"required":["schema_version","finding_id","rule_id","rule_version","profile_id","resolved_profile_hash","status","severity","target_type","affected_object_ids","current_value","expected_value","operator","unit","message","recommended_action","machine_checkable","autofix_class","automatic_fix_available","rule_status","critical_for_readiness","source_provenance","resolution_trace_reference","evaluation_method","evaluator_version"],"properties":{"schema_version":{"const":"1.0.0"},"finding_id":{"type":"string","pattern":"^finding:[a-f0-9]{24}$"},"rule_id":{"type":"string"},"rule_version":{"type":"string"},"profile_id":{"type":"string"},"resolved_profile_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"status":{"enum":["PASS","WARNING","BLOCKED","UNKNOWN","NOT_APPLICABLE","EVALUATION_ERROR"]},"severity":{"enum":["INFO","WARNING","BLOCKING"]},"target_type":{"type":"string"},"affected_object_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"current_value":{},"expected_value":{},"operator":{"type":"string"},"unit":{"type":["string","null"]},"message":{"type":"string"},"recommended_action":{"type":"string"},"machine_checkable":{"type":"boolean"},"autofix_class":{"type":"string"},"automatic_fix_available":{"const":false},"rule_status":{"enum":["VERIFIED","PARTIAL","UNKNOWN","CONFLICTED","STALE","NOT_APPLICABLE"]},"critical_for_readiness":{"type":"boolean"},"source_provenance":{"type":"array","items":{"type":"object","required":["source_id","evidence_id"]}},"resolution_trace_reference":{"type":"string"},"evaluation_method":{"type":"string"},"evaluator_version":{"type":"string"}}}
