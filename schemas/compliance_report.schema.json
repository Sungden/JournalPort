{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://journalport.org/schemas/v2/compliance_report.schema.json","title":"JournalPort ComplianceReport","type":"object","additionalProperties":false,"required":["schema_version","journalport_version","engine_version","input_manuscript_hash","canonical_manuscript_hash","profile_id","profile_version","resolved_profile_hash","evaluation_timestamp","readiness_status","summary","coverage","findings","profile_caveats","unsupported_manuscript_content","manual_review_requirements","disclaimer","report_hash"],"properties":{"schema_version":{"const":"2.0.0"},"journalport_version":{"type":"string"},"engine_version":{"type":"string"},"input_manuscript_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"canonical_manuscript_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"profile_id":{"type":"string"},"profile_version":{"type":"string"},"resolved_profile_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"evaluation_timestamp":{"type":"string","format":"date-time"},"readiness_status":{"enum":["SUBMISSION_READY","READY_WITH_WARNINGS","REQUIRES_MANUAL_REVIEW","BLOCKED","PROFILE_NOT_VERIFIABLE","EVALUATION_FAILED"]},"summary":{"type":"object"},"coverage":{"type":"object"},"findings":{"type":"array","items":{"$ref":"compliance_finding.schema.json"}},"profile_caveats":{"type":"array","items":{"type":"string"}},"unsupported_manuscript_content":{"type":"array","items":{"type":"string"}},"manual_review_requirements":{"type":"array","items":{"type":"string"}},"disclaimer":{"type":"string"},"report_hash":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}}
