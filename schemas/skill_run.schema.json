{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://journalport.org/schemas/v1/skill_run.schema.json",
  "title": "JournalPort skill run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "skill_version", "journalport_version", "input_artifacts", "profile_hash", "called_commands", "generated_artifacts", "final_status", "manual_review_items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "skill_version": {"type": "string"},
    "journalport_version": {"type": "string"},
    "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "profile_hash": {"type": ["string", "null"]},
    "called_commands": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 1}},
    "generated_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "final_status": {"type": "string", "minLength": 1},
    "manual_review_items": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }
  }
}
