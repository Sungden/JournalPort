  "evidence": [
    {"evidence_id": "ev:ncomms.initial-flexibility-2026", "source_id": "src:ncomms.how-to-submit-2026", "locator": "Initial submissions", "evidence_text": "For initial submissions, Nature Communications is flexible with regard to format; within reason, style and length will not influence consideration.", "evidence_hash": "sha256:3e59615ff3013f7f6f98350ca48839fec97426dbfe82ff9b81fff15cfa6e3c3f"},
    {"evidence_id": "ev:ncomms.initial-combined-file-2026", "source_id": "src:ncomms.how-to-submit-2026", "locator": "First submissions", "evidence_text": "For first submissions only, manuscript text and figures may be combined in one Word, TeX or PDF file up to 30 MB; figures may appear within the text or at the end.", "evidence_hash": "sha256:64b7d59a0b6b112b2f1492db907f5c7cf205f26963c89c2fa6fa16e6fcbf99e9"},
    {"evidence_id": "ev:ncomms.revision-files-2026", "source_id": "src:ncomms.how-to-submit-2026", "locator": "Revisions: File formats", "evidence_text": "For revisions, the manuscript text must be a single Word or TeX file and figures must be individual files.", "evidence_hash": "sha256:5ed8f7702470028bdbb7818d5154085802b5669def04e3cab720e944a0a93233"},
    {"evidence_id": "ev:ncomms.revision-order-2026", "source_id": "src:ncomms.how-to-submit-2026", "locator": "Revisions: Manuscript text", "evidence_text": "The revision manuscript order is title page, content-type sections, References, optional Acknowledgements, Author Contributions for Articles, Competing Interests, Figure Legends, then Tables.", "evidence_hash": "sha256:7fa60ec582d903cef043de609b44c0ecaaaba30cd1a17bf1229783afa2e62575"},
    {"evidence_id": "ev:ncomms.title-page-2026", "source_id": "src:ncomms.how-to-submit-2026", "locator": "Revisions: Title page", "evidence_text": "The title page includes affiliations and contact information, with corresponding authors indicated by an asterisk.", "evidence_hash": "sha256:f700fdea3991d4f189d3d94e301c1cca02f70f12d8128208bb918458bf343d3c"},
    {"evidence_id": "ev:ncomms.figure-legends-2026", "source_id": "src:ncomms.how-to-submit-2026", "locator": "Figure legends", "evidence_text": "Figure legends follow the references in numerical order; each begins with a brief title sentence and is no longer than 350 words.", "evidence_hash": "sha256:64dc3e2b84f4bdee7eec939f7b54ae785a9314e1ebbff044b88ac50f657d1bde"},
    {"evidence_id": "ev:ncomms.article-limits-2021", "source_id": "src:ncomms.formatting-guide-2021", "locator": "Pages 1–2: Title and Abstract", "evidence_text": "The formatting guide states that Article titles are 15 words or fewer and abstracts are 150 words or fewer.", "evidence_hash": "sha256:bfbf58b1f8c2be87ea910486580cc51f10308bf2eb82d0883982672247837d34"},
    {"evidence_id": "ev:ncomms.availability-2021", "source_id": "src:ncomms.formatting-guide-2021", "locator": "Page 3: Availability statements", "evidence_text": "All manuscripts must include a Data Availability statement; Code Availability is required when custom code or mathematical algorithms are central to the conclusions.", "evidence_hash": "sha256:a73ebb597f4e6db7566c557b09c34e0bec33737bf504ea339b3683750c71ce71"},
    {"evidence_id": "ev:ncomms.final-format-2026", "source_id": "src:ncomms.editorial-process-2026", "locator": "Final submission and acceptance", "evidence_text": "Final submissions must comply with format requirements and include final high-resolution figure files.", "evidence_hash": "sha256:40f25e9dc4712e90af6a915d2e325ed159c631c63775e9caf09662b0bd606de3"}
  ],
